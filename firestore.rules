rules_version = '2';

// Firestore security rules for the AWS Certification Trainer.
//
// Paste into the Firebase console:
//   Firestore Database -> Rules -> select all -> paste -> Publish
//
// The Firebase web config in docs/js/firebase-config.js is public by design.
// THIS FILE is what actually protects the data. Two principles:
//
//   1. A user's study progress is private to that user. Nobody else can read
//      what they answered, got wrong, or how ready they are.
//   2. The leaderboard is a separate, deliberately small summary document that
//      any signed-in user may read, but only its owner may write.
//
// Anything not matched below is denied by default, so there is no catch-all
// rule here — in Firestore a permissive rule elsewhere would win over one, and
// writing `allow read, write: if false` at the bottom gives a false sense of
// closing a door that was never open.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Keeps the shared document to the fields the board renders, and stops
    // anyone posting an arbitrarily large blob into a readable collection.
    function isValidSummary() {
      let d = request.resource.data;
      return d.uid == request.auth.uid
        && d.keys().hasOnly([
             'uid', 'displayName', 'color', 'answered', 'correct', 'accuracy',
             'mastered', 'certified', 'avgReadiness', 'streak', 'longestStreak',
             'updatedAt'
           ])
        && d.displayName is string
        && d.displayName.size() <= 24
        && d.color is string
        && d.color.size() <= 16
        && d.answered is number && d.answered >= 0
        && d.correct is number && d.correct >= 0
        && d.accuracy is number && d.accuracy >= 0 && d.accuracy <= 100
        && d.mastered is number && d.mastered >= 0 && d.mastered <= 50
        && d.certified is number && d.certified >= 0 && d.certified <= 50
        && d.avgReadiness is number && d.avgReadiness >= 0 && d.avgReadiness <= 100
        && d.streak is number && d.streak >= 0
        && d.longestStreak is number && d.longestStreak >= 0;
    }

    // ---- Private per-user data -------------------------------------
    // users/{uid}/data/{key} — one document per storage key. Owner only.
    match /users/{uid}/{document=**} {
      allow read, write: if isOwner(uid);
    }

    // ---- Shared leaderboard ----------------------------------------
    // One summary document per user. Readable by any signed-in member so the
    // board can render; writable only by the person it describes.
    match /leaderboard/{uid} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(uid) && isValidSummary();
      allow delete: if isOwner(uid);
    }
  }
}
